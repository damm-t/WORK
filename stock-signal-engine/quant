is_up() {
  [ -f "$RUN/$1.pid" ] || return 1
  local pid
  pid=$(cat "$RUN/$1.pid")
  [ -n "$pid" ] || return 1
  if [[ "${OSTYPE:-}" == "msys"* ]] || [[ "${OSTYPE:-}" == "cygwin"* ]]; then
    ps -W 2>/dev/null | grep -w "$pid" >/dev/null 2>&1
  else
    kill -0 "$pid" 2>/dev/null
  fi
}

start_bg() {
  local name="$1"; shift
  if is_up "$name"; then
    echo "• $name already running (pid $(cat "$RUN/$name.pid"))"
    return 0
  fi
  if command -v caffeinate >/dev/null 2>&1; then
    nohup caffeinate -ims "$@" >>"logs/$name.log" 2>&1 &
  else
    nohup "$@" >>"logs/$name.log" 2>&1 &
  fi
  echo $! >"$RUN/$name.pid"
  sleep 1
  if is_up "$name"; then
    echo "✅ $name started (pid $(cat "$RUN/$name.pid")) -> logs/$name.log"
  else
    echo "❌ $name failed to start -> see logs/$name.log"
    return 1
  fi
}

