kill_target() {
  local pid="${1:-}"
  [ -n "$pid" ] || return 0
  if [[ "${OSTYPE:-}" == "msys"* ]] || [[ "${OSTYPE:-}" == "cygwin"* ]]; then
    taskkill //F //PID "$pid" >/dev/null 2>&1 || true
    kill "$pid" 2>/dev/null || true
  else
    kill "$pid" 2>/dev/null || kill -9 "$pid" 2>/dev/null || true
  fi
}

stop_desk() {
  local target="${1:-all}"
  case "$target" in
    crypto|crypto_futures)
      if [ -f "$RUN/crypto_futures.pid" ]; then
        kill_target "$(cat "$RUN/crypto_futures.pid")"
        echo "• crypto_futures stopped"
      fi
      rm -f "$RUN/crypto_futures.pid"
      pkill -f 'execution.crypto_futures_autopilot' 2>/dev/null
      ;;
    futures|cme_futures|cme)
      if [ -f "$RUN/cme_futures.pid" ]; then
        kill_target "$(cat "$RUN/cme_futures.pid")"
        echo "• cme_futures stopped"
      fi
      rm -f "$RUN/cme_futures.pid"
