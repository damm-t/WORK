      pkill -f 'uvicorn webapp.app'                2>/dev/null
      pkill -f 'backtest.daily_routine'            2>/dev/null
      pkill -f 'QuantDeskWidget'                   2>/dev/null
      rm -f logs/autopilot.pid
      echo "All desks and components down."
      touch "$HOME/.quantdesk_disabled"
      ;;
  esac
}

