      if [ -f "$RUN/forex.pid" ]; then
        kill_target "$(cat "$RUN/forex.pid")"
        echo "• forex stopped"
      fi
      rm -f "$RUN/forex.pid"
      pkill -f 'execution.forex_autopilot' 2>/dev/null
      ;;
    stocks|autopilot)
      if [ -f "$RUN/autopilot.pid" ]; then
        kill_target "$(cat "$RUN/autopilot.pid")"
        echo "• autopilot stopped"
      fi
      rm -f "$RUN/autopilot.pid"
      pkill -f 'execution.autopilot' 2>/dev/null
      ;;
    webapp)
      if [ -f "$RUN/webapp.pid" ]; then
        kill_target "$(cat "$RUN/webapp.pid")"
        echo "• webapp stopped"
      fi
      rm -f "$RUN/webapp.pid"
      pkill -f 'uvicorn webapp.app' 2>/dev/null
      ;;
    all|*)
      echo "=== 🛑 STOPPING QUANT DESK (ALL 4 DESKS & SERVICES) ==="
      for n in autopilot crypto_futures cme_futures forex webapp routine night; do
        if [ -f "$RUN/$n.pid" ]; then
          kill_target "$(cat "$RUN/$n.pid")"
          echo "• $n stopped"
        fi
        rm -f "$RUN/$n.pid"
      done
      pkill -f 'execution.autopilot'               2>/dev/null
      pkill -f 'execution.crypto_futures_autopilot' 2>/dev/null
      pkill -f 'execution.cme_futures_autopilot'    2>/dev/null
