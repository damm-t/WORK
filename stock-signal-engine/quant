REMOTE_CONF=".remote_config"

deploy_remote() {
  local target="${1:-}"
  local remote_dir="${2:-~/stock-signal-engine}"

  if [ -n "$target" ]; then
    echo "REMOTE_TARGET=\"$target\"" > "$REMOTE_CONF"
    echo "REMOTE_DIR=\"$remote_dir\"" >> "$REMOTE_CONF"
  elif [ -f "$REMOTE_CONF" ]; then
    # shellcheck disable=SC1090
    source "$REMOTE_CONF"
    target="${REMOTE_TARGET:-}"
    remote_dir="${REMOTE_DIR:-~/stock-signal-engine}"
  fi

  if [ -z "$target" ]; then
    echo "❌ No remote target configured."
    echo "Usage:   ./quant deploy <user@ip-or-host> [remote_dir]"
    echo "Example: ./quant deploy ubuntu@192.168.1.120"
    return 1
  fi

  echo "==========================================================================="
  echo "🚀 [QUANT DEPLOY] Syncing Mac code -> 24/7 Engine Host ($target)"
  echo "==========================================================================="
  echo "• Remote Target : $target"
  echo "• Remote Path   : $remote_dir"
  echo ""

  # Test SSH connection
  if ! ssh -q -o BatchMode=yes -o ConnectTimeout=5 "$target" exit 2>/dev/null; then
    echo "ℹ️  Testing interactive SSH connection to $target..."
  fi

  # Create remote dir if not present
  ssh "$target" "\"C:\\Program Files\\Git\\bin\\bash.exe\" -lc \"mkdir -p $remote_dir\"" 2>/dev/null || \
  ssh "$target" "mkdir -p '$remote_dir'" || {
    echo "❌ Failed to connect to $target via SSH. Make sure SSH is running on the host."
    return 1
  }

  echo "📦 Syncing codebase (excluding virtualenv, git history, and runtime logs)..."
  tar --exclude='.venv' \
      --exclude='__pycache__' \
      --exclude='*.pyc' \
      --exclude='.git' \
      --exclude='.run' \
      --exclude='logs/*.log' \
      --exclude='logs/*.pid' \
      --exclude='.tempmediaStorage' \
      --exclude='node_modules' \
      --exclude='.DS_Store' \
      --exclude='.remote_config' \
      -cf - . | (
        ssh "$target" "\"C:\\Program Files\\Git\\bin\\bash.exe\" -lc \"cd $remote_dir && tar -xf -\"" 2>/dev/null || \
        ssh "$target" "cd \"$remote_dir\" && tar -xf -"
      )

  echo ""
  echo "🔄 Triggering remote reload on $target ..."
  ssh "$target" "\"C:\\Program Files\\Git\\bin\\bash.exe\" -lc \"cd $remote_dir && ./quant restart\"" 2>/dev/null || \
  ssh "$target" "bash -c 'cd \"$remote_dir\" && ./quant restart'"

  echo ""
  echo "==========================================================================="
  echo "✅ Remote deployment complete! 24/7 engine running on $target."
  echo "💡 To view the live cockpit on your Mac, run: ./quant tunnel"
  echo "==========================================================================="
}

tunnel_remote() {
  local action="${1:-start}"
  local target="${2:-}"

  if [ -n "$target" ]; then
    echo "REMOTE_TARGET=\"$target\"" > "$REMOTE_CONF"
  elif [ -f "$REMOTE_CONF" ]; then
    # shellcheck disable=SC1090
    source "$REMOTE_CONF"
    target="${REMOTE_TARGET:-}"
  fi

  case "$action" in
    stop)
      echo "🛑 Closing SSH Funnel..."
      pkill -f 'ssh.*-L.*8080:' 2>/dev/null && echo "Tunnel closed." || echo "No active tunnel found."
      ;;
    status)
      if pgrep -f 'ssh.*-L.*8080:' >/dev/null 2>&1; then
        echo "● SSH Funnel: ACTIVE"
        echo "  Forwarded: Remote 8080 -> Mac http://localhost:8080"
        echo "  Forwarded: Remote 8095 -> Mac http://localhost:8095"
      else
        echo "○ SSH Funnel: INACTIVE (Run './quant tunnel' to connect)"
      fi
      ;;
    start|*)
      if [ -z "$target" ]; then
        if [ "$action" != "start" ] && [[ "$action" == *"@"* || "$action" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
          target="$action"
          echo "REMOTE_TARGET=\"$target\"" > "$REMOTE_CONF"
        fi
      fi

      if [ -z "$target" ]; then
        echo "❌ No remote target configured."
        echo "Usage:   ./quant tunnel [user@ip-or-host]"
        echo "Example: ./quant tunnel ubuntu@192.168.1.120"
        return 1
      fi

      if pgrep -f 'ssh.*-L.*8080:' >/dev/null 2>&1; then
        echo "● SSH Funnel is ALREADY RUNNING!"
        echo "  👉 Cockpit  : http://localhost:8080"
        echo "  👉 Extractor: http://localhost:8095"
        return 0
      fi

      echo "⚡ Establishing encrypted SSH Funnel from $target to Mac localhost..."
      ssh -f -N -o ExitOnForwardFailure=yes \
          -L 8080:127.0.0.1:8080 \
          -L 8095:127.0.0.1:8095 \
          "$target"

      if [ $? -eq 0 ]; then
        echo "✅ Encrypted SSH Funnel connected!"
        echo "   👉 Cockpit  : http://localhost:8080"
        echo "   👉 Extractor: http://localhost:8095"
        echo "   (Remote 24/7 PIDs running; close your Mac anytime without stopping trades)"
      else
        echo "❌ Failed to connect SSH tunnel. Check your network or SSH credentials."
      fi
      ;;
  esac
}

case "${1:-start}" in
  start)
    TARGET="${2:-all}"
    case "$TARGET" in
      crypto|crypto_futures)
        start_crypto
        ;;
      futures|cme_futures|cme)
        start_futures
        ;;
      forex)
        start_forex
        ;;
      stocks|autopilot)
        start_bg autopilot "$PY" -m execution.autopilot --interval 900 \
                            --auto-select --min-auto-score "${MIN_AUTO_SCORE:-85}" \
                            --min-trade-score "${MIN_TRADE_SCORE:-85}" \
                            --heat "${MAX_PORTFOLIO_HEAT:-0.50}" \
                            --risk-pct "${RISK_PCT:-0.02}" || true
        ;;
      webapp)
        echo "🌐 Launching Web App Dashboard on Port 8080..."
        start_bg webapp "$PY" -m uvicorn webapp.app:app --host 0.0.0.0 --port 8080 || true
        ;;
      all|*)
        echo "==========================================================================="
        echo "   🚀 QUANT DESK AUTONOMOUS LAUNCH — 4 CONCURRENT ASSET DESKS"
        echo "==========================================================================="
        rm -f "$HOME/.quantdesk_disabled"

        # 1. Detect account funds & auto-allocate
        echo "🔍 Reading account capital from Alpaca..."
        DETECTED_CAPITAL=$("$PY" -c '
from execution import client
try:
    acc = client.get_account()
    print(round(float(acc.equity), 2))
except Exception:
    print(10000.0)
')
        CAPITAL="${CAPITAL:-$DETECTED_CAPITAL}"
        echo "💰 Total Account Equity: \$${CAPITAL}"

        # Auto-configure fractional sizing & gates based on account tier
        export SMALL_ACCOUNT_FRACTIONAL=1
        export MIN_TRADE_SCORE="${MIN_TRADE_SCORE:-85}"
        export MIN_AUTO_SCORE="${MIN_AUTO_SCORE:-85}"
        export MAX_PORTFOLIO_HEAT="${MAX_PORTFOLIO_HEAT:-0.50}"
        export DAILY_LOSS_LIMIT="${DAILY_LOSS_LIMIT:--0.03}"
        export RISK_PCT="${RISK_PCT:-0.02}"
        export SMALL_ACCOUNT_CAPITAL="${CAPITAL}"
        echo "⚙️  Discipline Guardrails: Grade A Gate (Score ≥ 85), Max Heat 50%, Daily Loss Cut -3%, 2% Kelly Risk"

        # 2. Run Quality Sniper Pre-Market Scan
        echo ""
        echo "🎯 Running Pre-Market Quality Sniper Scan across 27 core mega-caps..."
        "$PY" backtest/daily_sniper.py --capital "${CAPITAL}" --risk-pct "${RISK_PCT}"

        # 3. Launch Desk 1: US Equities Autopilot (9:30-16:00 ET + Extended)
        echo ""
        echo "🎯 Launching Desk 1: US Equities & Macro Autopilot..."
        start_bg autopilot "$PY" -m execution.autopilot --interval 900 \
                            --auto-select --min-auto-score "${MIN_AUTO_SCORE:-85}" \
                            --min-trade-score "${MIN_TRADE_SCORE:-85}" \
                            --heat "${MAX_PORTFOLIO_HEAT:-0.50}" \
                            --risk-pct "${RISK_PCT:-0.02}" || true

        # 4. Launch Desk 2: Crypto Perpetual Futures (24/7/365 CCXT Demo)
        echo ""
        start_crypto

        # 5. Launch Desk 3: CME Micro Index Futures (23h Demo)
        echo ""
        start_futures

        # 6. Launch Desk 4: Forex 24/5 Macro (Currencies Demo)
        echo ""
        start_forex

        # 7. Launch Web App Dashboard
        echo ""
        start_bg webapp "$PY" -m uvicorn webapp.app:app \
                        --host 0.0.0.0 --port 8080 || true

        # 8. Launch macOS Menu Bar Widget (macOS only)
        if [ "$(uname)" = "Darwin" ]; then
          echo "🍎 Launching macOS Menu Bar Widget..."
          ./mac_widget/launch.sh || true
        fi

        sleep 2
        if [ -x /usr/bin/open ] && [ "${NO_BROWSER:-0}" != "1" ]; then
          ( sleep 3; /usr/bin/open "http://localhost:8080" ) >/dev/null 2>&1 &
        fi

        echo ""
        echo "==========================================================================="
        echo "   ✅ QUANT DESK RUNNING 4 CONCURRENT DESKS (ISOLATED PIDS)"
        echo "==========================================================================="
        echo "   🏛️  Desk 1 (Stocks)  : PID $(cat "$RUN/autopilot.pid" 2>/dev/null || echo "N/A") (Alpaca Live Paper)"
        echo "   ⚡ Desk 2 (Crypto)  : PID $(cat "$RUN/crypto_futures.pid" 2>/dev/null || echo "N/A") (24/7 Perps Demo)"
        echo "   📈 Desk 3 (Futures) : PID $(cat "$RUN/cme_futures.pid" 2>/dev/null || echo "N/A") (CME Micro Demo)"
        echo "   💱 Desk 4 (Forex)   : PID $(cat "$RUN/forex.pid" 2>/dev/null || echo "N/A") (24/5 Macro Demo)"
        echo "   🌐 Web Dashboard   : http://localhost:8080 (Primary Cockpit)"
        echo "   🍎 Mac Widget       : Look at top-right macOS menu bar 📈"
        echo "   📊 Live Status      : ./quant status"
        echo "   📋 Tail Logs        : ./quant logs [stocks|crypto|futures|forex|webapp]"
        echo "   🛑 Stop Desk        : ./quant stop [all|stocks|crypto|futures|forex]"
        echo "==========================================================================="
        ;;
    esac
    ;;

  stop|quit|q)
    stop_desk "${2:-all}" ;;

  status)
    show_status "${2:-}" ;;

  restart)
    target="${2:-all}"
    case "$target" in
      all)
        "$0" stop; sleep 2; "$0" start ;;
      tunnel|cloudflared)
        echo "🔄 Restarting Cloudflare Remote Tunnel (Middle Server)..."
        "$PY" -c "from webapp.tunnel_manager import restart_tunnel; r = restart_tunnel(); print('✅ Fresh Tunnel URL: ' + str(r.get('tunnel_url')))"
        ;;
      webapp)
        echo "🔄 Restarting Web App Server & Cockpit..."
        "$0" stop webapp; sleep 1; "$0" start webapp ;;
      *)
        "$0" stop "$target"; sleep 1; "$0" start "$target" ;;
    esac
    ;;

  cloudflare|cf-tunnel)
    sub="${2:-status}"
    case "$sub" in
      restart)
        echo "🔄 Restarting Cloudflare Remote Tunnel (Middle Server)..."
        "$PY" -c "from webapp.tunnel_manager import restart_tunnel; r = restart_tunnel(); print('✅ Fresh Tunnel URL: ' + str(r.get('tunnel_url')))"
        ;;
      stop)
        "$PY" -c "from webapp.tunnel_manager import stop_tunnel; stop_tunnel(); print('🛑 Cloudflare Tunnel Stopped')"
        ;;
      start)
        "$PY" -c "from webapp.tunnel_manager import start_tunnel; r = start_tunnel(); print('🌐 Tunnel URL: ' + str(r.get('tunnel_url')))"
        ;;
      status|*)
        "$PY" -c "from webapp.tunnel_manager import get_remote_status; import json; print(json.dumps(get_remote_status(), indent=2))"
        ;;
    esac
    ;;

  exits|journal)
    shift
    "$PY" -m execution.trade_journal --exits "$@" ;;

  dips|opportunities)
    shift
    "$PY" backtest/market_scanner.py --dips "$@" ;;

  ross)
    shift
    "$PY" market/low_float_scanner.py "$@" ;;

  mock-ross)
    shift
    "$PY" backtest/ross_momentum_sim.py "$@" ;;

  scan)
    shift
    "$PY" backtest/market_scanner.py "$@" ;;

  sniper)
    shift
    "$PY" backtest/daily_sniper.py "$@" ;;

  refer|alpha)
    shift
    target="${1:-}"
    if [[ "$target" == http* ]]; then
      "$PY" -m instagram_extractor.cli extract "$target" || true
      meta="instagram_extractor/output/DdsCOmdkZux_metadata.json"
      if [ -f "$meta" ]; then
        "$PY" -m market.external_alpha_bridge --meta "$meta"
      fi
    elif [ -n "$target" ]; then
      "$PY" -m market.external_alpha_bridge --tickers "$target"
    else
      "$PY" -m market.external_alpha_bridge --meta instagram_extractor/output/DdsCOmdkZux_metadata.json
    fi
    ;;

  graphify)
    shift
    subcmd="${1:-status}"
    case "$subcmd" in
      update|extract)
        echo "🌐 Updating Graphify Knowledge Graph (AST-only, 0 tokens)..."
        graphify extract . --code-only
        graphify cluster-only .
        ;;
      query|q)
        shift
        graphify query "$*" ;;
      path)
        shift
        graphify path "$1" "$2" --undirected ;;
      explain)
        shift
        graphify explain "$*" ;;
      tree)
        graphify tree --output graphify-out/GRAPH_TREE.html
        echo "🌳 D3 tree generated at graphify-out/GRAPH_TREE.html"
        ;;
      status)
        if [ -f "graphify-out/graph.json" ]; then
          "$PY" -c "
import json
g = json.load(open('graphify-out/graph.json'))
nodes = len(g.get('nodes', []))
edges = len(g.get('links', g.get('edges', [])))
print(f'✅ Knowledge Graph: {nodes} nodes, {edges} edges')
print('   Web Visualization : http://localhost:8080/graph')
print('   Tree View HTML    : graphify-out/GRAPH_TREE.html')
print('   Architecture Doc  : graphify-out/GRAPH_REPORT.md')
"
        else
          echo "⚠️ No graph found. Run './quant graphify update' first."
        fi
        ;;
      *)
        graphify "$subcmd" "$@" ;;
    esac
    ;;

  logs)
    target="${2:-autopilot}"
    case "$target" in
      crypto|crypto_futures) target="crypto_futures" ;;
      futures|cme_futures|cme) target="cme_futures" ;;
      forex) target="forex" ;;
      webapp) target="webapp" ;;
      autopilot|stocks) target="autopilot" ;;
    esac
    tail -n 60 -f "logs/${target}.log" ;;

  night)
    shift
    start_bg night "$PY" pipeline.py --phase night --top 1 --min-scan 70 \
                   --execute "$@" || true
    echo "Bracket queued pre-open — review reports/night_*.json"
    ;;

  heal)
    shift
    echo "🚑 Watchdog Healing requested: $*"
    for comp in "$@"; do
      case "$comp" in
        autopilot|stocks)
          start_bg autopilot "$PY" -m execution.autopilot --interval 900 \
                              --auto-select --min-auto-score "${MIN_AUTO_SCORE:-85}" \
                              --min-trade-score "${MIN_TRADE_SCORE:-85}" \
                              --heat "${MAX_PORTFOLIO_HEAT:-0.50}" \
                              --risk-pct "${RISK_PCT:-0.02}" || true
          ;;
        crypto|crypto_futures)
          start_crypto
          ;;
        futures|cme_futures)
          start_futures
          ;;
        forex)
          start_forex
          ;;
        webapp)
          start_bg webapp "$PY" -m uvicorn webapp.app:app \
                          --host 0.0.0.0 --port 8080 || true
          ;;
      esac
    done
    ;;

  widget|hud)
    shift
    exec ./mac_widget/launch.sh "$@" ;;

  deploy)
    shift
    deploy_remote "$@" ;;

  tunnel)
    shift
    tunnel_remote "$@" ;;

  help|--help|-h|*)
    echo "╔════════════════════════════════════════════════════════════════╗"
    echo "║   QUANT DESK — 4-ASSET CONCURRENT AUTONOMOUS CONTROL PLANE     ║"
    echo "╚════════════════════════════════════════════════════════════════╝"
    echo "  Usage:"
    echo "    ./quant start [desk]   Starts all 4 desks or a specific desk"
    echo "    ./quant stop [desk]    Stops all desks or a specific desk cleanly"
    echo "    ./quant status         Shows running state, PIDs, equity & open positions"
    echo "    ./quant logs [desk]    Streams live logs (stocks|crypto|futures|forex|webapp)"
    echo "    ./quant exits          Shows database ledger of all partial & full exits"
    echo "    ./quant dips           Scans market for High-Volume Dip opportunities"
    echo "    ./quant ross           Scans small-caps using Ross Cameron's 5 Pillars"
    echo "    ./quant mock-ross      Simulates Ross Cameron 1st pullback momentum execution"
    echo "    ./quant scan           Ranks entire market universe (breakouts & dips)"
    echo "    ./quant sniper         Shows today's #1 single best setup card"
    echo "    ./quant refer [target] Cross-references external bot/IG ideas through quant math"
    echo "    ./quant widget         Launches native macOS menu bar status widget"
    echo "    ./quant restart        Restarts the entire desk"
    echo "    ./quant deploy [host]  Syncs Mac code to 24/7 host & restarts remote engine"
    echo "    ./quant tunnel [host]  Funnels remote 8080 & 8095 to Mac localhost"
    echo ""
    echo "  Desks:"
    echo "    Desk 1 (Stocks)   : US Equities & Macro Autopilot (Alpaca Paper / Live)"
    echo "    Desk 2 (Crypto)   : 24/7/365 CCXT Perpetual Futures Demo (Binance/OKX)"
    echo "    Desk 3 (Futures)  : CME Micro Index Futures Demo 23h (MES, MNQ, MCL, MGC)"
    echo "    Desk 4 (Forex)    : 24/5 Macro Currencies Demo"
    echo ""
    echo "  Optional Overrides:"
    echo "    RISK_PCT=0.01 ./quant start    Risk 1% per trade (default 0.02 = 2%)"
    echo "    CAPITAL=10000 ./quant start    Force a specific capital allocation"
    echo "    NO_BROWSER=1  ./quant start    Don't auto-open browser"
    echo "================================================================="
    ;;
esac